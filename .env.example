# MemePilot Auto V2 — exemple de configuration (placeholders uniquement)
# Copier vers .env et remplir. Ne JAMAIS versionner .env.

# Mode d'exécution : paper (défaut) | live
# live est refusé tant que les Phases 1 à 7 ne sont pas validées.
MEMEPILOT_MODE=paper

# Chemins
MEMEPILOT_LIMITS_PATH=config/limits.yaml
MEMEPILOT_DB_PATH=data/memepilot.db

# Exécutable gmgn-cli (installé via: npm install -g gmgn-cli@1.7.1)
GMGN_CLI_PATH=gmgn-cli

# Adresse publique du wallet de trading GMGN (pas un secret).
# À remplir après la vérification de la Phase 1 (scripts/check_wallet_binding.py).
GMGN_TRADING_WALLET=

# Telegram (Phase 5) — notifications sortantes uniquement.
# Jeton : @BotFather sur Telegram. Chat ID : envoie « bonjour » à ton bot puis lance
# python scripts\telegram_setup.py (il le trouve et l'écrit ici). Ne versionne jamais ce fichier.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Chien de garde externe (facultatif, D-037) : prévient même quand le PC est éteint.
# Crée un « check » gratuit sur https://healthchecks.io (période 2 min, délai de grâce 5 min),
# branche-le à Telegram dans Integrations, puis colle ici son URL de ping (https://hc-ping.com/...).
MEMEPILOT_HEALTHCHECK_URL=

# ─────────────────────────────────────────────────────────────
# Les identifiants GMGN NE vont PAS dans ce fichier.
# gmgn-cli les lit lui-même dans ~/.config/gmgn/.env :
#   GMGN_API_KEY=...
#   GMGN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."
# Le code Python de MemePilot ne lit jamais ces deux valeurs.
# ─────────────────────────────────────────────────────────────
